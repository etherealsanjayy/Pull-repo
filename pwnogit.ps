# Download and extract private repo safely without Git
$User = Read-Host "GitHub Username"
$SecureToken = Read-Host -AsSecureString "GitHub Token (PAT)"
$Token = (New-Object PSCredential("u", $SecureToken)).GetNetworkCredential().Password

$Owner = Read-Host "Repo Owner (Enter for same)"
if (-not $Owner) { $Owner = $User }
$Repo = Read-Host "Repo Name"

# No branch specified = auto-downloads repo's default branch (main/master/etc.)
$Url  = "https://api.github.com/repos/$Owner/$Repo/zipball"
$Zip  = ".\_tmp_$Repo.zip"
$Temp = ".\_tmp_$Repo"
$Dest = ".\$Repo"

Write-Host "Downloading..." -ForegroundColor Cyan
try {
    Invoke-RestMethod -Uri $Url -Headers @{ Authorization = "Bearer $Token" } -OutFile $Zip
    if (Test-Path $Temp) { Remove-Item $Temp -Recurse -Force }
    Expand-Archive -Path $Zip -DestinationPath $Temp -Force

    $Inner = Get-ChildItem -Path $Temp -Directory | Select-Object -First 1

    # Ask before overwriting an existing folder
    if (Test-Path $Dest) {
        $Choice = Read-Host "Folder '$Dest' already exists. Overwrite? (y/N)"
        if ($Choice -eq 'y') {
            Remove-Item $Dest -Recurse -Force
        } else {
            $Stamp = Get-Date -Format "yyyyMMdd_HHmmss"
            $Dest = ".\${Repo}_$Stamp"
        }
    }

    Move-Item -Path $Inner.FullName -Destination $Dest
    Remove-Item $Temp, $Zip -Recurse -Force
    Write-Host "Done: Extracted cleanly to '$Dest'." -ForegroundColor Green
} catch {
    if (Test-Path $Temp) { Remove-Item $Temp -Recurse -Force }
    if (Test-Path $Zip)  { Remove-Item $Zip -Force }
    Write-Host "Error: Download failed. Check credentials or repo name." -ForegroundColor Red
}
